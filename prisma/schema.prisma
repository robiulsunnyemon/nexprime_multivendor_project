generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  CUSTOMER
  VENDOR
  ADMIN
}


enum AccountStatus {
  ACTIVE
  SUSPEND
  INACTIVE
}

model User {
  id                     Int           @id @default(autoincrement())
  fullname               String
  email                  String        @unique
  phonenumber            String        @unique
  password               String


  role                   Role          @default(CUSTOMER)
  status                 AccountStatus @default(INACTIVE)
  is_verified            Boolean       @default(false)


  residentcard_frontside String
  residentcard_backside  String


  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt


  followedStores         Store[]       @relation("UserFollowedStores")
  otps                   OTP[]
  store                  Store?
  kycFiles               KYCFile[]
  marketingProducts      MarketingProduct[]
  refreshTokens          RefreshToken[]
  searchHistories        SearchHistory[]
  cartItems              CartItem[]
}


model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}



model Store {
  id          Int      @id @default(autoincrement())
  name        String
  bio         String?
  address     String
  photo       String
  vendorId    Int      @unique
  vendor      User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  followers   User[]   @relation("UserFollowedStores")
  products    Product[]
}


enum KYCStatus {
  PENDING
  ACTIVE
  SUSPEND
  REJECTED
}


model KYCFile {
  id        Int       @id @default(autoincrement())
  title     String    @default("vendor_kyc")
  fileUrl   String
  status    KYCStatus @default(PENDING)
  vendorId  Int
  vendor    User      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}


model OTP {
  id        Int      @id @default(autoincrement())
  code      String
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}


model SystemSetting {
  id                    Int     @id @default(1)
  isRegistrationEnabled Boolean @default(true)
}


model MarketingProductSetting {
  id                  Int     @id @default(1)
  isPublishingEnabled Boolean @default(true)
  publishingFee       Float   @default(0.50)
}


model Banner {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MainCategory {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum ShippingResponsibility {
  CUSTOMER
  VENDOR
}

model Product {
  id                     Int                    @id @default(autoincrement())
  name                   String
  description            String?
  basePrice              Float
  stockUnits             Int                    @default(0)
  size                   String?
  colors                 String?
  isOnSale               Boolean                @default(false)
  salePrice              Float?
  discountPercentage     Float?
  shippingResponsibility ShippingResponsibility @default(CUSTOMER)
  shippingCharge         Float                  @default(0)
  images                 String[] // List of image URLs
  
  storeId                Int
  store                  Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  categories             SubCategory[]          @relation("ProductCategories")
  
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  cartItems              CartItem[]
}

model SubCategory {
  id             Int          @id @default(autoincrement())
  name           String
  image          String?
  mainCategoryId Int
  mainCategory   MainCategory @relation(fields: [mainCategoryId], references: [id], onDelete: Cascade)
  
  products       Product[]    @relation("ProductCategories")
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}


model MarketingProduct {
  id                     Int                    @id @default(autoincrement())
  name                   String
  goodsType              String
  location               String
  description            String?
  price                  Float
  publishingFee          Float                  @default(0)
  shippingResponsibility ShippingResponsibility @default(CUSTOMER)
  shippingCharge         Float                  @default(0)
  images                 String[]
  
  creatorId              Int
  creator                User                   @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
}

model SearchHistory {
  id        Int      @id @default(autoincrement())
  query     String
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
}

model StaticPage {
  id        Int      @id @default(autoincrement())
  key       String   @unique // e.g., 'privacy_policy', 'terms_conditions', 'about_us'
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum FaqStatus {
  ACTIVE
  INACTIVE
}

model FAQ {
  id        Int       @id @default(autoincrement())
  question  String
  answer    String    @db.Text
  status    FaqStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
